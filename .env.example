# 服务器配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=123456
DB_NAME=yujian

# Redis配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT配置
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRES_IN=24h

# ==================== 文件上传配置 ====================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# ==================== CORS 跨域白名单 ====================
# 生产环境必须设置，多个域名用逗号分隔
# 示例: https://app.your-domain.com,https://admin.your-domain.com
ALLOWED_ORIGINS=http://localhost:3000

# ==================== 内测模拟模式 ====================
# 短信模拟：设为 true 时验证码固定为 123456（仅限 NODE_ENV!=production 使用）
# ⚠️ S2 护栏：NODE_ENV=production 且 SMS_SIMULATE=true 时服务器拒绝启动
# 生产环境对接真实短信后设为 false（验证码随机，经 PM2 日志输出兜底）
SMS_SIMULATE=true
# 支付模拟：设为 true 时自动确认支付/充值，生产环境对接微信支付宝后设为 false
# ⚠️ S2 护栏：NODE_ENV=production 且 SIMULATE_PAYMENT=true 时服务器拒绝启动
SIMULATE_PAYMENT=true

# ==================== 短信服务配置 ====================
SMS_ACCESS_KEY=your_sms_access_key
SMS_SECRET_KEY=your_sms_secret_key

# ==================== 礼物分成比例 ====================
# 接收者收到礼物的金币分成比例（0~1），默认 0.7 即 70%
GIFT_SHARE_RATIO=0.7

# ==================== 阿里云OSS配置（生产环境，内测可忽略） ====================
# OSS_REGION=your_oss_region
# OSS_ACCESS_KEY=your_oss_access_key
# OSS_SECRET_KEY=your_oss_secret_key
# OSS_BUCKET=your_oss_bucket

# ==================== 限流配置 ====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ==================== 高德地图配置（逆地理编码） ====================
# 用于根据经纬度查询行政区划（省/市/区），驱动"同城"匹配
# 申请地址：https://lbs.amap.com/dev/key/app
GAODE_MAP_KEY=your_gaode_map_key_here

# ==================== 运维告警（S24） ====================
# 错误告警 webhook：服务器 500 错误时异步推送 JSON 到该 URL（飞书/钉钉/企业微信机器人）
# 留空则不启用错误告警
ERROR_ALERT_WEBHOOK_URL=

# ==================== 支付网关（S23 预留，不接真实 SDK） ====================
# 模拟支付开关：true 时 VIP/充值自动到账；false 时走支付网关预留（wechat/alipay 未接入）
# SIMULATE_PAYMENT=true